# Veteran Millionaire — environment variables
# Copy this file to .env.local for development, and add the same keys in
# Vercel: Project Settings -> Environment Variables. Nothing in this MVP
# currently requires these to run (all content is mock data), but the code
# is structured to read from them once each integration is wired up.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://veteranmillionaire.com

# --- Analytics / tracking (lib/analytics.ts reads these) ---
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Search Console ---
GOOGLE_SITE_VERIFICATION=

# --- Supabase (recommended DB for members, submissions, leads) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- CMS (pick one — see README for recommendation) ---
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_TOKEN=
# — or —
PAYLOAD_SECRET=
DATABASE_URI=

# --- Resend (transactional + newsletter email) ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=hello@veteranmillionaire.com

# --- Stripe (future premium community / courses) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Community / social ---
NEXT_PUBLIC_FACEBOOK_GROUP_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=

# --- JoeLendsToVets mortgage intake (Talk to Joe form destination) ---
MORTGAGE_LEAD_WEBHOOK_URL=
MORTGAGE_LEAD_NOTIFY_EMAIL=
